@model Dentigo.Presentation.Models.CaseListViewModel
@{
    ViewData["Title"] = "Cases";
}
<section class="page-heading"><div><p class="eyebrow">Your dental cases</p><h1>Cases</h1><p class="muted">Find any case by patient, treatment or case number, and open its history.</p></div></section>
<section class="panel list-view">
    <div class="panel-heading"><div><h2>All cases</h2><p>Newest activity first by default.</p></div><span class="count-chip">@Model.Results.TotalCount results</span></div>

    <form method="get" asp-action="Cases" class="list-toolbar" autocomplete="off" data-autosubmit>
        <input type="hidden" asp-for="Sort" />
        <input type="hidden" asp-for="Dir" />
        <input type="hidden" asp-for="PageSize" />
        <div class="field grow">
            <label asp-for="Search">Search</label>
            <input asp-for="Search" type="search" placeholder="Patient, treatment or DC-000123" />
            <span asp-validation-for="Search" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Status"></label>
            <select asp-for="Status">
                <option value="">All statuses</option>
                @foreach (var s in Enum.GetValues<DentalCaseStatus>())
                {
                    <option value="@s">@s.ToLabel()</option>
                }
            </select>
            <span asp-validation-for="Status" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="From"></label>
            <input asp-for="From" />
            <span asp-validation-for="From" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="To"></label>
            <input asp-for="To" />
            <span asp-validation-for="To" class="field-error"></span>
        </div>
        <button class="button primary small" type="submit">Apply</button>
        <a class="button secondary small" asp-action="Cases">Reset</a>
    </form>

    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <partial name="_SortHeader" model='new SortHeaderViewModel("case", "CASE", Model.Sort, Model.Dir)' />
                    <partial name="_SortHeader" model='new SortHeaderViewModel("patient", "PATIENT", Model.Sort, Model.Dir)' />
                    <partial name="_SortHeader" model='new SortHeaderViewModel("treatment", "TREATMENT", Model.Sort, Model.Dir)' />
                    <partial name="_SortHeader" model='new SortHeaderViewModel("status", "STATUS", Model.Sort, Model.Dir)' />
                    <partial name="_SortHeader" model='new SortHeaderViewModel("updated", "UPDATED", Model.Sort, Model.Dir, "desc")' />
                </tr>
            </thead>
            <tbody><partial name="_CaseRows" model="Model.Results.Items" /></tbody>
        </table>
    </div>
    @if (Model.Results.Items.Count == 0)
    {
        <p class="empty-state">No cases match your search and filters.</p>
    }
    <partial name="_Pager" model="Model.Results.ToPager()" />
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/dentigo-validation.js" asp-append-version="true"></script>
    <script src="~/js/doctor-manual-validation.js" asp-append-version="true"></script>
    <script src="~/js/doctor-lists.js" asp-append-version="true"></script>
}
