@model Dentigo.Presentation.Models.Patient.DentalChartViewModel

@{
    ViewData["Title"] = "Dental Chart";
    Layout = "~/Views/Shared/_SecretaryLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Dental Chart</h1>
        <p class="page-subtitle">Patient: @Model.PatientName</p>
    </div>

    <a asp-controller="Patients"
       asp-action="Details"
       asp-route-id="@Model.PatientId"
       class="btn btn-outline">
        Back to Patient
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <h3>Add Tooth</h3>

    <form asp-controller="Patients"
          asp-action="AddTooth"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="NewTooth.PatientId"
               value="@Model.PatientId" />

        <div class="form-group">
            <label asp-for="NewTooth.ToothNumber">Tooth Number *</label>
            <input asp-for="NewTooth.ToothNumber"
                   type="text"
                   class="form-control"
                   placeholder="Example: 11, 12, 21" />
            <span asp-validation-for="NewTooth.ToothNumber" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="NewTooth.Notes">Notes</label>
            <textarea asp-for="NewTooth.Notes"
                      class="form-control"
                      rows="3"
                      placeholder="Optional notes"></textarea>
            <span asp-validation-for="NewTooth.Notes" class="text-danger"></span>
        </div>

        <button type="submit" class="btn">
            Add Tooth
        </button>
    </form>
</div>

<div class="card">
    <h3>Clinical Findings</h3>

    <p>Record a medical finding for one of the patient's teeth.</p>

    <a asp-controller="Patients"
       asp-action="AddClinicalFinding"
       asp-route-patientId="@Model.PatientId"
       class="btn">
        Add Clinical Finding
    </a>
</div>

<div class="card">
    <h3>Patient Teeth</h3>

    @if (!Model.Teeth.Any())
    {
        <p>No teeth registered for this patient yet.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Tooth Number</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tooth in Model.Teeth)
                {
                    <tr>
                        <td>@tooth.ToothNumber</td>
                        <td>@(tooth.Notes ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
