
@model Dentigo.Presentation.Models.Patient.PatientViewModel

@{
    ViewData["Title"] = "Patient Details";
    Layout = "~/Views/Shared/_SecretaryLayout.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Patient Details</h1>
        <p class="page-subtitle">View patient information</p>
    </div>

    <a asp-controller="Patients"
       asp-action="Index"
       class="btn btn-outline">
        Back to Patients
    </a>
</div>

<div class="card">
    <div class="form-group">
        <label>Patient ID</label>
        <p>@Model.Id</p>
    </div>

    <div class="form-group">
        <label>Full Name</label>
        <p>@Model.FullName</p>
    </div>

    <div class="form-group">
        <label>Phone Number</label>
        <p>@(Model.PhoneNumber ?? "-")</p>
    </div>

    <div class="form-group">
        <label>Registration Date</label>
        <p>@Model.CreatedAt.ToString("dd MMM yyyy")</p>
    </div>

    <a asp-controller="Patients"
       asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn">
        Edit Patient
    </a>

    <a asp-controller="Patients"
       asp-action="DentalChart"
       asp-route-id="@Model.Id"
       class="btn">
        Dental Chart
    </a>
</div>
