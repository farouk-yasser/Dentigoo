@model Dentigo.Presentation.Models.Patient.CreatePatientViewModel

@{
    ViewData["Title"] = "Register Patient";
    Layout = "~/Views/Shared/_SecretaryLayout.cshtml";
}

<div class="hd">
    <div>
        <h1>Register New Patient</h1>
        <p class="sub">Enter the patient's basic information</p>
    </div>
</div>

<div class="card">
    <form asp-controller="Patients"
          asp-action="Create"
          method="post"
          class="fm">

        @Html.AntiForgeryToken()

        <div class="f">
            <label asp-for="FullName">Full Name *</label>
            <input asp-for="FullName"
                   type="text"
                   placeholder="e.g. Ahmed Mohamed" />
            <span asp-validation-for="FullName" class="err"></span>
        </div>

        <div class="f">
            <label asp-for="PhoneNumber">Contact Details</label>
            <input asp-for="PhoneNumber"
                   type="text"
                   placeholder="Phone number" />
            <span asp-validation-for="PhoneNumber" class="err"></span>
        </div>

        <div class="ac">
            <button class="btn" type="submit">
                Save Patient
            </button>

            <a class="btn s"
               asp-controller="Patients"
               asp-action="Index">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
