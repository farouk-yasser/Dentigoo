@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title | Dentigo</title>
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app">
        <aside class="sidebar">
            <h2>Dentigo</h2>
            <span class="role">Secretary</span>

            <nav>
                <a asp-controller="Patient" asp-action="Index"
                   class="@(controller == "Patient" ? "active" : "")">Patients</a>

                <a asp-controller="Payment" asp-action="Index"
                   class="@(controller == "Payment" ? "active" : "")">Payments</a>
            </nav>
        </aside>

        <main class="content">
            @if (TempData["Success"] != null)
            {
                <div class="alert-success" role="status">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert-danger" role="alert">@TempData["Error"]</div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>